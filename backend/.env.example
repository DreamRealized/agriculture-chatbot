# Copy to backend/.env. No credentials are required for local Ollama.
# Existing shell variables and .env.<APP_ENV> (default: .env.dev) take precedence.
SERVER_INFO={"host":"127.0.0.1","port":11434}

# Text model used for local testing; pull it with Ollama before chatting.
OLLAMA_TEXT_MODEL=qwen3:4b-instruct

# Optional external integrations. Configure their URLs in config.jsonc first.
ENABLE_RAG=false
ENABLE_MCP=false
