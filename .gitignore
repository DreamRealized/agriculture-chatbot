.aws/credentials
.aws/sso/cache/
.aws/cli/cache/
credentials.json
service-account.json
service-account-key.json
*.private-key.pem
*-private.pem
private.pem
*.key
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
